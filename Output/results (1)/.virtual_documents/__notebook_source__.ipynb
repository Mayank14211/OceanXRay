LANDMARKS = [
    ("Chennai", 80.27, 13.08, False), ("Kolkata", 88.36, 22.57, False),
    ("Visakhapatnam", 83.30, 17.69, False), ("Colombo", 79.86, 6.93, False),
    ("Port Blair", 92.73, 11.62, False), ("Andaman-Nicobar ridge", 93.0, 10.0, True),
